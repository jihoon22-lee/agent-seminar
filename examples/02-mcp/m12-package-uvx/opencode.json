{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "glossary-pkg": {
      "type": "local",
      "command": ["python", "-m", "team_glossary_mcp"],
      "environment": { "PYTHONPATH": "src" },
      "enabled": true
    },
    "glossary-uvx": {
      "type": "local",
      "command": ["uvx", "--from", ".", "team-glossary-mcp"],
      "enabled": false,
      "timeout": 60000
    }
  }
}
